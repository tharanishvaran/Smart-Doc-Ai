# SmartDoc AI / RAG Project 2.1 Configuration Template

# Flask Environment
FLASK_ENV=development
SECRET_KEY=replace-with-secure-random-secret-key
JWT_SECRET_KEY=replace-with-secure-jwt-secret-key

# Google OAuth 2.0 (Google Cloud Console Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database Connection (MySQL or SQLite fallback)
# MySQL Example: mysql+pymysql://user:password@localhost:3306/smartdoc_db
DATABASE_URL=sqlite:///app.db

# Task Queue & Cache (Redis & Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set CELERY_ALWAYS_EAGER=true during local development if running without Redis
CELERY_ALWAYS_EAGER=false

# Document Storage Driver (local, s3, cloudinary)
STORAGE_DRIVER=local
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800

# AI Models & Vector Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
CHROMA_PERSIST_DIRECTORY=chroma_db

# Batching & Controlled Concurrency Limits
EMBEDDING_BATCH_SIZE=32
VECTOR_BATCH_SIZE=50
MAX_CONCURRENT_UPLOADS=3
